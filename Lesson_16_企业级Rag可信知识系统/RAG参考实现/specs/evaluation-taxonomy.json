      "locator_precision"
    ],
    "pptx": [
      "slide_number",
      "region_if_available"
    ],
    "image": [
      "image_name",
      "bbox_if_available"
    ],
    "html": [
      "heading_path",
      "element_or_block_id"
    ],
    "markdown": [
      "heading_path",
      "line_range"
    ],
    "txt": [
      "line_range"
    ],
    "csv": [
      "row_range",
      "column_names",
      "record_key"
    ]
  },
  "coverage_matrices": [
    [
      "primary_task",
      "primary_source_format"
    ],
    [
      "primary_task",
      "evidence_span"
    ],
    [
      "source_formats",
      "layout_challenges"
    ],
    [
      "primary_task",
      "expected_behavior"
    ]
  ],
  "validation_requirements": [
    "200 个唯一 case_id，主任务与 split 配额和为 200",
    "20 条 smoke 全部属于 development",
    "所有标签属于 taxonomy 允许值；业务元数据允许明确 null",
    "同一 fact_family_id 不跨 development 与 holdout",
    "可回答题的必需证据全部可以定位并由人工核查",
    "图片理解题确实依赖图片信息",
    "各格式至少有真实材料与对应端到端案例",
    "拒答和澄清题有缺失信息说明及核查范围",
    "数值题含单位、计算规则与容差",
    "报告单元格显示实际 n；小样本类别避免夸大百分比",
    "运行日志保存模型、配置、语料版本、时间和成本；不记录密钥"
  ],
  "current_case_count": 200,
  "current_case_status": "200题已通过作者来源核查及数量/分类完整检查；尚未独立复审和真实模型评估。多维交叉覆盖仍按实际矩阵披露，不声称全组合覆盖。"
}
